generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  fullName     String?
  avatarUrl    String?
  passwordHash String?
  provider     AuthProvider @default(EMAIL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}